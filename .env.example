# ==============================================================================
# CodeLens AI - Environment Configuration Example (Phase 1)
# ==============================================================================
# Copy this file to '.env' and adjust the variables as needed.
# Note: Real API keys are NOT required for Phase 1.
# ==============================================================================

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=codelens-ai-insecure-dev-secret-key-change-in-production

# Server Settings
HOST=127.0.0.1
PORT=5000

# GitHub API Integration (optional, increases rate limits)
GITHUB_TOKEN=

# AI Chatbot & LLM Backend Configuration
# Groq API Configuration (Fast repository reasoning)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Alternative models: llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it

# Other supported providers (Gemini, OpenAI)
LLM_API_KEY=
LLM_MODEL=
LLM_PROVIDER=auto
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=1200
OPENAI_API_KEY=
